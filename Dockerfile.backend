FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DJANGO_SETTINGS_MODULE=config.settings.production

WORKDIR /app

# Dépendances système (psycopg2, Pillow, etc.)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev gcc && \
    rm -rf /var/lib/apt/lists/*

# Dépendances Python — copie tout le dossier requirements/
# (production.txt référence base.txt via "-r base.txt")
COPY backend/requirements/ /tmp/requirements/
RUN pip install --no-cache-dir -r /tmp/requirements/production.txt

# Code source
COPY backend/ .

# Option B1 : le RAG (embed + FAISS) tourne dans Colab depuis Drive.
# Render se contente d'orchestrer (Django + ontology + ClickHouse facts).
# Plus de pré-téléchargement fastembed → ~300 MB et ~180 MB RAM économisés.

# Collecte des statiques au build (servis par WhiteNoise au runtime)
RUN python manage.py collectstatic --noinput || true

EXPOSE 8000

# Render injecte $PORT dynamiquement. Free tier = 512 MB RAM → 2 workers / 4 threads.
# Migrations à chaque boot pour rester en phase avec le schéma déployé.
CMD ["sh", "-c", "python manage.py migrate --noinput && gunicorn config.wsgi:application --bind 0.0.0.0:${PORT:-8000} --workers ${WEB_CONCURRENCY:-2} --threads 4 --timeout 120 --access-logfile - --error-logfile -"]
