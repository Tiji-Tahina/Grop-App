# =============================================
# DEPENDENCIES — Never commit
# =============================================
node_modules/
backend/venv/
backend/venv*/
venv/
venv*/
.venv/

# =============================================
# BUILD & DIST — Auto-generated
# =============================================
dist/
dist-ssr/
build/

# =============================================
# AI TOOLS / AGENTS — Local files only
# =============================================
.claude/
CLAUDE.md
claude.md
.opencode/
opencode.json
graphify-out/
AGENTS.md
agent.md
blender_scripts/

# =============================================
# AI & RAG — Stored on Drive/Cloud
# =============================================
backend/rag/data/vector_store/index.faiss
backend/rag/data/vector_store/metadata.pkl
backend/rag/data/documents/*.json
backend/rag/data/knowledge_base/*.json

# =============================================
# LARGE GEOSPATIAL DATA (>100MB)
# =============================================
*.asc
*.tif
*.tiff
*.geotiff
madagascar_srtm*
srtm_south*
madagascar_heightmap.png
viewport_snapshot.png

# =============================================
# LOCAL DATABASE
# =============================================
backend/db.sqlite3

# =============================================
# ENVIRONMENT VARIABLES — SENSITIVE
# =============================================
.env
**/.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local

# =============================================
# LOGS
# =============================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# =============================================
# PYTHON — Bytecode & caches
# =============================================
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
*.egg
.pytest_cache/
.mypy_cache/

# =============================================
# LOCAL LLM MODELS — Too large for Git
# =============================================
backend/models/
!backend/models/SETUP.md

# =============================================
# EDITORS & IDEs
# =============================================
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.local

# =============================================
# OPERATING SYSTEM
# =============================================
.DS_Store
Thumbs.db
desktop.ini

# =============================================
# PACKAGE MANAGER — Lock file optional depending on team
# =============================================
# package-lock.json  # Uncomment if you prefer not to commit it

# ONNX MODELS — Generated by fastembed / convert_to_onnx.py
*.onnx
*.ort

# PYTHON BINARY FILES — Generated by ML pipelines
*.npy
*.pkl
!backend/rag/data/vector_store/metadata.pkl

# TEST COVERAGE REPORTS
.coverage
htmlcov/

# OUTPUT FILES — Long background processes
nohup.out

# GADM source GeoJSON (regenerable, large) — only generated paths are committed
scripts/data/gadm*.json
